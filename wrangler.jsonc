// Cloudflare config. `npm run build` first: the built ./dist is served as static assets.
// Catalog requests go through a small Worker (src/worker.mjs) that fetches the file at
// its canonical path, saving the redirect Cloudflare would send for "genre=…";
// everything else is a plain static file request.
{
  "name": "live-channels",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/catalog/*"]
  },
  // The addon's address. Cloudflare creates its DNS record and certificate on the first
  // deploy. The workflow builds with this as SITE_URL, so posters and the install page
  // link to it.
  "routes": [{ "pattern": "stremio-channels-addon.jantoom.com", "custom_domain": true }],
  "workers_dev": false
}
